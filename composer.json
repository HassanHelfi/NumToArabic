{
    "name": "hassanhelfi/number-to-arabic",
    "description": "Convert numbers and currencies to Arabic words in PHP & Laravel (تفقيط الأعداد والعملات)",
    "authors": [
        {
            "name": "HassanHelfi",
            "email": "hbhassanhelfi@gmail.com"
        }
    ],
    "keywords": [
        "php",
        "laravel",
        "arabic",
        "number",
        "numbers-to-words",
        "tafqeet",
        "tafqit",
        "currency"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Hassanhelfi\\NumberToArabic\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Hassanhelfi\\NumberToArabic\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5 || ^10.1"
    },
    "extra": {
        "laravel": {
            "aliases": {
                "NumToArabic": "Hassanhelfi\\NumberToArabic\\NumToArabic"
            }
        }
    }
}